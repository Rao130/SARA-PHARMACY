# Example environment variables for Sara Pharmacy
# Copy this to a file named .env (do NOT commit .env) and fill values.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=your-32+ char secret here
NODE_ENV=production
PORT=10000

# Frontend Vite env (if using Render static site or local dev)
VITE_API_BASE_URL=https://your-backend.example.com/api/v1
VITE_API_URL=https://your-backend.example.com
VITE_SOCKET_URL=https://your-backend.example.com
PORT=5001
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRE=15m
NODE_ENV=development

# OCR Settings
TESSERACT_LANG=eng
